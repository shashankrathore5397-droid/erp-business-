{
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/vite",
            "config": {
                "distDir": "frontend/dist"
            }
        },
        {
            "src": "backend/wsgi.py",
            "use": "@vercel/python",
            "config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/wsgi.py"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/"
        }
    ]
}
